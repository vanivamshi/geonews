# Copy to backend/.env (local) or set in your host's secret store.
ANTHROPIC_API_KEY=

GEONEWS_DATABASE_URL=postgresql+asyncpg://geonews:geonews@localhost:5432/geonews
GEONEWS_REDIS_URL=redis://localhost:6379/0
GEONEWS_ADMIN_TOKEN=change-me
GEONEWS_CORS_ORIGINS=http://localhost:3000
GEONEWS_WEB_BASE_URL=http://localhost:3000

# Required by the Nominatim usage policy: identify your app and give a contact.
GEONEWS_NOMINATIM_USER_AGENT=geonews-news-agent/0.1 (you@example.com)

# Models (defaults shown). Subagents/classifier on Haiku, orchestrator/briefings on Opus.
# GEONEWS_ORCHESTRATOR_MODEL=claude-opus-5-5
# GEONEWS_SUBAGENT_MODEL=claude-haiku-5-5
# GEONEWS_CLASSIFIER_BACKEND=claude   # or "lora" once ml/serve_classifier.py is running

# Delivery (optional)
# GEONEWS_SMTP_HOST=smtp.postmarkapp.com
# GEONEWS_SMTP_USER=
# GEONEWS_SMTP_PASSWORD=
# GEONEWS_SMTP_FROM=briefing@yourdomain.com
# GEONEWS_TELEGRAM_BOT_TOKEN=

# Tracing (optional): any OTLP/HTTP endpoint, e.g. Langfuse
# GEONEWS_OTEL_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# GEONEWS_OTEL_HEADERS=Authorization=Basic <base64 public:secret>
